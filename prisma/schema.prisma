generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  DISPUTED
}

model Admin {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
  logs         AdminLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  icon        String    @default("grid")
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, sortOrder])
}

model Product {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  categoryId          String
  shortDescription    String        @default("")
  description         String        @default("")
  included            String        @default("")
  audience            String        @default("")
  requirements        String        @default("")
  delivery            String        @default("")
  refundPolicy        String        @default("")
  productType         String        @default("E-book")
  imageUrl            String?
  socialImageUrl      String?
  priceCents          Int
  compareAtPriceCents Int?
  checkoutUrl         String?
  seoTitle            String?
  metaDescription     String?
  status              ProductStatus @default(DRAFT)
  featured            Boolean       @default(false)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orders              Order[]
  images              ProductImage[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([featured, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Customer {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  providerId String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id              String      @id @default(cuid())
  productId       String
  customerId      String?
  provider        String      @default("kiwify")
  providerOrderId String?     @unique
  status          OrderStatus @default(PENDING)
  amountCents     Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@index([status, createdAt])
  @@index([productId, createdAt])
}

model Payment {
  id                String      @id @default(cuid())
  orderId           String
  providerPaymentId String      @unique
  status            OrderStatus
  amountCents       Int
  confirmedAt       DateTime?
  createdAt         DateTime    @default(now())
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model IntegrationEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  quote       String
  authorized  Boolean @default(false)
  active      Boolean @default(false)
  sortOrder   Int     @default(0)
}

model SlugRedirect {
  id        String   @id @default(cuid())
  entity    String
  oldSlug   String
  targetId  String
  createdAt DateTime @default(now())

  @@unique([entity, oldSlug])
  @@index([entity, targetId])
}
