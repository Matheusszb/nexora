# Vercel: Supabase > Connect > Transaction pooler (porta 6543).
# Copie a string do seu projeto e substitua a senha; nao adivinhe o host.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:6543/postgres?uselibpqcompat=true&sslmode=require&pgbouncer=true"

# Migrações Prisma: Supabase > Connect > Session pooler (porta 5432).
# A URL Direct connection tambem serve se a maquina alcancar IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require"

# Na Vercel, use o dominio de producao real, com https:// e sem barra final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcional: upload de imagens pelo painel, usando Supabase Storage.
# No painel Supabase, crie um bucket PUBLICO chamado product-images.
# Guarde a chave secreta somente no servidor/Vercel; nunca use NEXT_PUBLIC_ nela.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Necessárias apenas para executar npm run admin:create uma vez.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
