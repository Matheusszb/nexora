# Copie a URL de Session pooler (porta 5432) em Supabase > Connect.
# Substitua o projeto, host e senha pelos valores do SEU projeto Nexora.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require"

# Migrações Prisma. Pode usar a mesma URL Session pooler; se houver IPv6,
# use aqui a URL Direct connection do painel Supabase.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Necessárias apenas para executar npm run admin:create uma vez.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
